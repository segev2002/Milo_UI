# Where the Milo API is listening. Read by the Vite dev proxy, which forwards
# /agent and /health so the browser can use a relative base URL.
MILO_API_URL=http://localhost:8000

# Optional dev convenience: with these set, the console opens straight onto the
# live API instead of sample data. Both are also settable in the UI, under
# Connection, which is what a browser-stored value overrides them with.
# VITE_MILO_TOKEN=eyJhbGciOi…
# VITE_MILO_API_URL=
